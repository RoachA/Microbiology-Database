<Window x:Class="Microscopy_Database.EntryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Details" Height="680" Width="700"
        WindowStartupLocation="CenterOwner" Background="#121212">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title & Folder Action -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Click="BtnOpenFolder_Click" Content="📁 Open Folder" 
                    DockPanel.Dock="Right" Padding="10,5" FontSize="12" Background="#3E3E42" 
                    Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock x:Name="TxtObservationId" Text="OBS000" FontSize="12" FontWeight="Bold" Foreground="#007ACC"/>
                <TextBox x:Name="TxtName" Text="Entry Details" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" 
                         Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="0"/>
            </StackPanel>
        </DockPanel>

        <!-- Metadata Subtitle (Date / Time) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Border Background="#2D2D30" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                <TextBlock x:Name="TxtDate" Foreground="#CCCCCC" FontSize="12"/>
            </Border>
            <Border Background="#2D2D30" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                <TextBlock x:Name="TxtTime" Foreground="#CCCCCC" FontSize="12"/>
            </Border>
            <Border Background="#2D2D30" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="TxtConfidence" Foreground="#4CAF50" FontWeight="Bold" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Content Area: Metadata Grid & Notes & Gallery -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Detailed Properties Grid -->
                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,15" BorderBrush="#2D2D30" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Col 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Sample Source" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtSource" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"
                                     Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="2"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Collection Location" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtLocation" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"
                                     Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="2"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Sample Type" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtSampleType" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"
                                     Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="2"/>
                        </StackPanel>

                        <!-- Col 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Organism Group" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <!-- Replaced TextBox with custom dark-mode ComboBox -->
                            <ComboBox x:Name="CbOrganismGroup" Height="26" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46" IsEnabled="False">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                                                        <ToggleButton x:Name="toggleButton" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="false" ClickMode="Press">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="20"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="6,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                        <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide" Placement="Bottom">
                                                            <Border x:Name="dropDownBorder" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}">
                                                                <ScrollViewer x:Name="DropDownScrollViewer">
                                                                    <ItemsPresenter x:Name="ItemsPresenter"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#2D2D30"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3F3F46"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#007ACC"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>

                                <!-- Same Enum Tag Options -->
                                <ComboBoxItem Content="--- PROTOZOA &amp; CILIATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Paramecium (Ciliate)" Tag="Paramecium"/>
                                <ComboBoxItem Content="Vorticella (Stalked Ciliate)" Tag="Vorticella"/>
                                <ComboBoxItem Content="Stentor (Trumpet Ciliate)" Tag="Stentor"/>
                                <ComboBoxItem Content="Spirostomum (Worm Ciliate)" Tag="Spirostomum"/>
                                <ComboBoxItem Content="Euplotes (Hypotrich Ciliate)" Tag="Euplotes"/>
                                <ComboBoxItem Content="Colpidium / Colpoda" Tag="ColpidiumColpoda"/>
                                <ComboBoxItem Content="Lacrymaria (Swan Animalcule)" Tag="Lacrymaria"/>
                                <ComboBoxItem Content="Blepharisma (Pink Ciliate)" Tag="Blepharisma"/>
                                <ComboBoxItem Content="Halteria" Tag="Halteria"/>
                                <ComboBoxItem Content="Didinium" Tag="Didinium"/>

                                <ComboBoxItem Content="--- AMOEBOIDS &amp; FLAGELLATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Amoeba proteus (Amoeba)" Tag="AmoebaProteus"/>
                                <ComboBoxItem Content="Arcella (Testate Amoeba)" Tag="Arcella"/>
                                <ComboBoxItem Content="Difflugia (Shell-building Amoeba)" Tag="Difflugia"/>
                                <ComboBoxItem Content="Actinophrys (Sun Animalcule / Heliozoan)" Tag="Actinophrys"/>
                                <ComboBoxItem Content="Euglena (Euglenoid)" Tag="Euglena"/>
                                <ComboBoxItem Content="Volvox (Colonial Flagellate)" Tag="Volvox"/>
                                <ComboBoxItem Content="Phacus" Tag="Phacus"/>
                                <ComboBoxItem Content="Peranema" Tag="Peranema"/>

                                <ComboBoxItem Content="--- MICRO-ANIMALS &amp; POND INVERTEBRATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Rotifera (Rotifers / Wheel Animalcules)" Tag="Rotifera"/>
                                <ComboBoxItem Content="Hydra (Cnidaria)" Tag="Hydra"/>
                                <ComboBoxItem Content="Daphnia (Water Flea / Cladocera)" Tag="Daphnia"/>
                                <ComboBoxItem Content="Cyclops (Copepod)" Tag="Cyclops"/>
                                <ComboBoxItem Content="Ostracod (Seed Shrimp)" Tag="Ostracod"/>
                                <ComboBoxItem Content="Tardigrade (Water Bear)" Tag="Tardigrade"/>
                                <ComboBoxItem Content="Nematoda (Roundworm)" Tag="Nematoda"/>
                                <ComboBoxItem Content="Gastrotrich" Tag="Gastrotrich"/>
                                <ComboBoxItem Content="Planarian (Flatworm)" Tag="Planarian"/>
                                <ComboBoxItem Content="Bryozoan (Moss Animal statoblast)" Tag="Bryozoan"/>

                                <ComboBoxItem Content="--- ALGAE &amp; PHYTOPLANKTON ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Spirogyra (Green Algae Filament)" Tag="Spirogyra"/>
                                <ComboBoxItem Content="Closterium (Desmid)" Tag="Closterium"/>
                                <ComboBoxItem Content="Cosmarium (Desmid)" Tag="Cosmarium"/>
                                <ComboBoxItem Content="Pediastrum (Colonial Green Algae)" Tag="Pediastrum"/>
                                <ComboBoxItem Content="Scenedesmus" Tag="Scenedesmus"/>
                                <ComboBoxItem Content="Diatoms - Centric" Tag="DiatomCentric"/>
                                <ComboBoxItem Content="Diatoms - Pennate" Tag="DiatomPennate"/>
                                <ComboBoxItem Content="Cyanobacteria (Blue-Green)" Tag="Cyanobacteria"/>
                                <ComboBoxItem Content="Cladophora" Tag="Cladophora"/>

                                <ComboBoxItem Content="--- FUNGI &amp; BACTERIA ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Saccharomycetaceae (Budding Yeast)" Tag="Yeast"/>
                                <ComboBoxItem Content="Actinomycetes (Filamentous Bacteria)" Tag="Actinomycetes"/>
                                <ComboBoxItem Content="Zoogloea (Bacterial Matrix)" Tag="Zoogloea"/>

                                <ComboBoxItem Content="--- OTHER / UNKNOWN ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
                                <ComboBoxItem Content="Unidentified Specimen" Tag="Unidentified"/>
                                <ComboBoxItem Content="Detritus / Mineral Particle" Tag="Detritus"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Identification" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtIdentification" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium"
                                     Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Notes Section -->
                <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="14" Foreground="#888888" Margin="0,0,0,5"/>
                <Border Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,0,20" BorderBrush="#2D2D30" BorderThickness="1">
                    <TextBox x:Name="TxtNotes" Foreground="#FFFFFF" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="Transparent" BorderThickness="0" IsReadOnly="True" Padding="2"/>
                </Border>

                <!-- Attached Images Section -->
                <TextBlock Text="Attached Images" FontWeight="SemiBold" FontSize="14" Foreground="#888888" Margin="0,0,0,8"/>
                <ItemsControl x:Name="ImagesGalleryContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="BtnOpenImage_Click" Tag="{Binding}" Margin="0,0,10,10" Padding="0" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Click to open image">
                                <Border CornerRadius="4" ClipToBounds="True" BorderBrush="#3F3F46" BorderThickness="1">
                                    <Image Source="{Binding}" Width="110" Height="110" Stretch="UniformToFill"/>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Edit Mode & Close Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnEditToggle" Grid.Column="1" Content="✏️ Edit Record" Click="BtnEditToggle_Click" Height="32" Width="120" Margin="0,0,10,0"
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Content="Close" Click="BtnClose_Click" Height="32" Width="100"
                    Background="#3E3E42" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>