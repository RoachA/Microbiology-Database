<Window x:Class="Microscopy_Database.TaxonomyReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microorganism Taxonomy Reference" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="#121212">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Pond Life Taxonomy &amp; Wikipedia Guide" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Click any card to open its Wikipedia article in your browser." FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Grouped List of Organisms -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrganismItemsControl">
                <!-- Define how groups are styled and laid out -->
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <!-- Category Header Style -->
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#4682B4" Margin="0,15,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <!-- Layout for items *inside* each group -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </ItemsControl.GroupStyle>

                <!-- Individual Card Template (Unchanged) -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Height="100" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,10,10" Padding="10" Cursor="Hand" MouseLeftButtonDown="Card_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Local Image Thumbnail -->
                                <Border Grid.Column="0" CornerRadius="4" ClipToBounds="True" Background="#2D2D30" VerticalAlignment="Center" HorizontalAlignment="Center" Width="55" Height="55">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#4682B4" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="🌐 View on Wikipedia" FontSize="10" Foreground="#4CAF50"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>