<Window x:Class="Microscopy_Database.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microscopy Database" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#121212">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Left Form Panel -->
            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="500" />
            <!-- GridSplitter Column -->
            <ColumnDefinition Width="10" />
            <!-- Right Entries Display -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

       <!-- LEFT PANEL: Entry Input Form -->
<Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="15" BorderBrush="#2D2D30"
        BorderThickness="1">
    <Border.Effect>
        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.4" ShadowDepth="3" />
    </Border.Effect>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Add New Record" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"
                       Foreground="#FFFFFF" />

            <TextBlock Text="Entry Name" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtName" Padding="6" Margin="0,0,0,6" Background="#2D2D30" Foreground="#FFFFFF"
                     BorderBrush="#3F3F46" SelectionBrush="#4682B4" />
            
<!-- ORGANISM GROUP SELECTION FIELD -->
<DockPanel LastChildFill="False" Margin="0,3,0,5">
    <TextBlock Text="Organism Group / Family" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" />
    <Button Content="?" FontWeight="Bold" Width="22" Height="20" 
            DockPanel.Dock="Right" Background="#3E3E42" Foreground="#FFFFFF" BorderThickness="0" 
            Cursor="Hand" ToolTip="Open Taxonomy &amp; Wikipedia Guide" 
            Click="BtnOpenTaxonomyGuide_Click"/>
</DockPanel>    
            <ComboBox x:Name="CbOrganismGroup" Height="28" 
                      Margin="0,0,0,5" 
                      Background="#2D2D30" 
                      Foreground="#FFFFFF" 
                      BorderBrush="#3F3F46">
    
    <!-- Bulletproof Dark Mode Template (Prevents white flashing/Windows styling) -->
    <ComboBox.Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="templateRoot" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"/>
                            <ToggleButton x:Name="toggleButton" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="false" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="6,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide" Placement="Bottom">
                                <Border x:Name="dropDownBorder" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ComboBox.Style>

    <!-- Dark Hover and Selection Styling -->
    <ComboBox.ItemContainerStyle>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4682B4"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ComboBox.ItemContainerStyle>

    <!-- Categorized Items with Enum Tags -->
    <ComboBoxItem Content="--- PROTOZOA &amp; CILIATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Paramecium (Ciliate)" Tag="Paramecium" IsSelected="True"/>
    <ComboBoxItem Content="Vorticella (Stalked Ciliate)" Tag="Vorticella"/>
    <ComboBoxItem Content="Stentor (Trumpet Ciliate)" Tag="Stentor"/>
    <ComboBoxItem Content="Spirostomum (Worm Ciliate)" Tag="Spirostomum"/>
    <ComboBoxItem Content="Euplotes (Hypotrich Ciliate)" Tag="Euplotes"/>
    <ComboBoxItem Content="Colpidium / Colpoda" Tag="ColpidiumColpoda"/>
    <ComboBoxItem Content="Lacrymaria (Swan Animalcule)" Tag="Lacrymaria"/>
    <ComboBoxItem Content="Blepharisma (Pink Ciliate)" Tag="Blepharisma"/>
    <ComboBoxItem Content="Halteria" Tag="Halteria"/>
    <ComboBoxItem Content="Didinium" Tag="Didinium"/>

    <ComboBoxItem Content="--- AMOEBOIDS &amp; FLAGELLATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Amoeba proteus (Amoeba)" Tag="AmoebaProteus"/>
    <ComboBoxItem Content="Arcella (Testate Amoeba)" Tag="Arcella"/>
    <ComboBoxItem Content="Difflugia (Shell-building Amoeba)" Tag="Difflugia"/>
    <ComboBoxItem Content="Actinophrys (Sun Animalcule / Heliozoan)" Tag="Actinophrys"/>
    <ComboBoxItem Content="Euglena (Euglenoid)" Tag="Euglena"/>
    <ComboBoxItem Content="Volvox (Colonial Flagellate)" Tag="Volvox"/>
    <ComboBoxItem Content="Phacus" Tag="Phacus"/>
    <ComboBoxItem Content="Peranema" Tag="Peranema"/>

    <ComboBoxItem Content="--- MICRO-ANIMALS &amp; POND INVERTEBRATES ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Rotifera (Rotifers / Wheel Animalcules)" Tag="Rotifera"/>
    <ComboBoxItem Content="Hydra (Cnidaria)" Tag="Hydra"/>
    <ComboBoxItem Content="Daphnia (Water Flea / Cladocera)" Tag="Daphnia"/>
    <ComboBoxItem Content="Cyclops (Copepod)" Tag="Cyclops"/>
    <ComboBoxItem Content="Ostracod (Seed Shrimp)" Tag="Ostracod"/>
    <ComboBoxItem Content="Tardigrade (Water Bear)" Tag="Tardigrade"/>
    <ComboBoxItem Content="Nematoda (Roundworm)" Tag="Nematoda"/>
    <ComboBoxItem Content="Gastrotrich" Tag="Gastrotrich"/>
    <ComboBoxItem Content="Planarian (Flatworm)" Tag="Planarian"/>
    <ComboBoxItem Content="Bryozoan (Moss Animal statoblast)" Tag="Bryozoan"/>

    <ComboBoxItem Content="--- ALGAE &amp; PHYTOPLANKTON ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Spirogyra (Green Algae Filament)" Tag="Spirogyra"/>
    <ComboBoxItem Content="Closterium (Desmid)" Tag="Closterium"/>
    <ComboBoxItem Content="Cosmarium (Desmid)" Tag="Cosmarium"/>
    <ComboBoxItem Content="Pediastrum (Colonial Green Algae)" Tag="Pediastrum"/>
    <ComboBoxItem Content="Scenedesmus" Tag="Scenedesmus"/>
    <ComboBoxItem Content="Diatoms - Centric" Tag="DiatomCentric"/>
    <ComboBoxItem Content="Diatoms - Pennate" Tag="DiatomPennate"/>
    <ComboBoxItem Content="Cyanobacteria (Blue-Green)" Tag="Cyanobacteria"/>
    <ComboBoxItem Content="Cladophora" Tag="Cladophora"/>

    <ComboBoxItem Content="--- FUNGI &amp; BACTERIA ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Saccharomycetaceae (Budding Yeast)" Tag="Yeast"/>
    <ComboBoxItem Content="Actinomycetes (Filamentous Bacteria)" Tag="Actinomycetes"/>
    <ComboBoxItem Content="Zoogloea (Bacterial Matrix)" Tag="Zoogloea"/>
    
    <ComboBoxItem Content="--- OTHER / UNKNOWN ---" FontWeight="Bold" Foreground="#888888" IsEnabled="False"/>
    <ComboBoxItem Content="Unidentified Specimen" Tag="Unidentified"/>
    <ComboBoxItem Content="Detritus / Mineral Particle" Tag="Detritus"/>
</ComboBox>
            
             <TextBlock Text="Identification" FontWeight="SemiBold" Margin="0,3,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtIdentification" Padding="6" Margin="0,0,0,6" Background="#2D2D30" Foreground="#FFFFFF"
                     BorderBrush="#3F3F46" SelectionBrush="#4B93A3" />

            <TextBlock Text="Identification Confidence" FontWeight="SemiBold" Margin="0,3,0,6" Foreground="#CCCCCC" />
<ComboBox x:Name="CbConfidence" 
          Height="28" 
          Margin="0,0,0,6" 
          Background="#2D2D30" 
          Foreground="#FFFFFF" 
          BorderBrush="#3F3F46">
    
    <ComboBox.Style>
        <Style TargetType="ComboBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Main Closed Box Background & Border -->
                            <Border x:Name="templateRoot" 
                                    Background="#2D2D30" 
                                    BorderBrush="#3F3F46" 
                                    BorderThickness="1"/>
                            
                            <!-- Dropdown Arrow Button -->
                            <ToggleButton x:Name="toggleButton" 
                                          Background="Transparent"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="false"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Dropdown Arrow Path -->
                                                <Path x:Name="arrow" Grid.Column="1" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Fill="#CCCCCC" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Content Presenter (Shows selected item text) -->
                            <ContentPresenter x:Name="contentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,0,20,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>

                            <!-- Popup Menu -->
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   PopupAnimation="Slide" 
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder" 
                                        Background="#2D2D30" 
                                        BorderBrush="#3F3F46" 
                                        BorderThickness="1" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.IsTabStop="False"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ComboBox.Style>

    <!-- Forces dropdown list items to stay dark on hover/selection -->
    <ComboBox.ItemContainerStyle>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ComboBox.ItemContainerStyle>

    <ComboBoxItem Content="Possible" IsSelected="True"/>
    <ComboBoxItem Content="Probably"/>
    <ComboBoxItem Content="Confirmed"/>
</ComboBox>
            
            <TextBlock Text="Date" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <DatePicker x:Name="DpDate" Padding="4" Margin="0,0,0,6"
                        Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="Background" Value="#2D2D30" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="SelectionBrush" Value="#4682B4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DatePickerTextBox">
                                    <TextBox x:Name="PART_Text"
                                             Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                             Background="#2D2D30"
                                             Foreground="#FFFFFF"
                                             BorderThickness="0"
                                             VerticalAlignment="Center"
                                             Padding="2" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>

            <TextBlock Text="Time" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtTime" Padding="6" Margin="0,0,0,6" ToolTip="Format HH:mm:ss"
                     Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46" SelectionBrush="#4682B4" />

            <!-- NEW OBSERVATION METADATA FIELDS -->
            <TextBlock Text="Sample Source" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtSampleSource" Padding="6" Margin="0,0,0,6" Background="#2D2D30" Foreground="#FFFFFF"
                     BorderBrush="#3F3F46" SelectionBrush="#4682B4" />

            <TextBlock Text="Collection Location" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtCollectionLocation" Padding="6" Margin="0,0,0,6" Background="#2D2D30" Foreground="#FFFFFF"
                     BorderBrush="#3F3F46" SelectionBrush="#4682B4" />

            <TextBlock Text="Sample Type" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtSampleType" Padding="6" Margin="0,0,0,6" Background="#2D2D30" Foreground="#FFFFFF"
                     BorderBrush="#3F3F46" SelectionBrush="#4682B4" />
            
            
            <!-- END OF NEW FIELDS -->

            <TextBlock Text="Images" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtImages" Padding="6" IsReadOnly="True" Background="#252526"
                         Foreground="#888888" BorderBrush="#3F3F46" />
                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseImages_Click" Padding="10,6"
                        Margin="5,0,0,0" Background="#3E3E42" Foreground="#FFFFFF" BorderThickness="0"
                        Cursor="Hand" />
            </Grid>
            <ListBox x:Name="LstSelectedImages" Height="70" Margin="0,0,0,12"
                     Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46"
                     MouseDoubleClick="LstSelectedImages_MouseDoubleClick"
                     ToolTip="Double-click an item to remove it from selection">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="11" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#CCCCCC" />
            <TextBox x:Name="TxtNotes" Padding="6" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,15" Background="#2D2D30" Foreground="#FFFFFF" BorderBrush="#3F3F46"
                     SelectionBrush="#4682B4" />

            <!-- Save Button -->
            <Button Content="Save Record" Click="BtnSave_Click" Height="36"
                    Background="#4682B4" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Clear Database Button -->
            <Button Content="Clear Database" Click="BtnClearDatabase_Click" Height="30" Margin="0,10,0,0"
                    Background="#7D3838" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Border>

        <!-- RESIZABLE SPLITTER HANDLE -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#3F3F46" ResizeBehavior="PreviousAndNext" Cursor="SizeWE">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- RIGHT PANEL: Display Views & Toggle -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header, Live Search Bar & View Toggle Control -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Records" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="0,0,15,0" />

                <!-- Search Input Field -->
                <Border Background="#2D2D30" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Width="220"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="TxtSearch" Padding="6,4" Background="Transparent" Foreground="#FFFFFF"
                                 BorderThickness="0" SelectionBrush="#4682B4" TextChanged="TxtSearch_TextChanged" />
                        <TextBlock Text="🔍 Search name, date, notes..." Foreground="#777777" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Toggle Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                    <RadioButton x:Name="RadCardView" Content="Grid Cards" IsChecked="True"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="10,5" Background="#2D2D30" Foreground="#FFFFFF"
                                 BorderBrush="#3F3F46" Cursor="Hand" Margin="0,0,4,0" />
                    <RadioButton x:Name="RadListView" Content="List Tokens"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Padding="10,5" Background="#2D2D30" Foreground="#FFFFFF"
                                 BorderBrush="#3F3F46" Cursor="Hand" />
                    <!-- Help / Microbiology Reference Button -->
                    <Button Content="?" Click="BtnHelp_Click" Width="32" Height="30" Margin="8,0,0,0"
                            Background="#3E3E42" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                            BorderThickness="0" Cursor="Hand" ToolTip="Microbiology Resources &amp; Reference Links">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>


            <!-- 1. COMPACT GRID / CARD VIEW PRESENTATION -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RadListView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl x:Name="GridCardsContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E" Width="210" CornerRadius="8" Padding="10" Margin="0,0,10,10"
                                    BorderBrush="#2D2D30" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonDown="EntryCard_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" Color="Black" Opacity="0.25" ShadowDepth="2" />
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: Name, Folder Button & Delete Button -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Click="BtnOpenFolder_Click" Tag="{Binding Id}" Content="📁"
                                                    Padding="4,2" FontSize="11" Background="#3E3E42"
                                                    Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Open Folder" Margin="0,0,4,0" />
                                            <Button Click="BtnDeleteEntry_Click" Tag="{Binding Id}" Content="🗑️"
                                                    Padding="4,2" FontSize="11" Background="#693733"
                                                    Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Delete Record" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Date & Time Info -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Date, StringFormat='\{0:yyyy-MM-dd\}'}"
                                                   Foreground="#999999" FontSize="11" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Time, StringFormat='\{0:hh\\:mm\}'}"
                                                   Foreground="#777777" FontSize="11" />
                                    </StackPanel>

                                    <!-- Image Thumbnails -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ImagePaths}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="BtnOpenImage_Click" Tag="{Binding}" Margin="0,2,4,2"
                                                        Padding="0"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        ToolTip="Click to open image">
                                                    <Border CornerRadius="3" ClipToBounds="True" BorderBrush="#3F3F46"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding}" Width="52" Height="52"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. COMPACT LIST VIEW PRESENTATION -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=RadListView}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl x:Name="ListViewContainer">
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Border Background="#1E1E1E" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                    BorderBrush="#2D2D30" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonDown="EntryCard_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />   <!-- Observation ID (e.g. OBS001) -->
                        <ColumnDefinition Width="100" />  <!-- Date -->
                        <ColumnDefinition Width="110" />  <!-- Name -->
                        <ColumnDefinition Width="120" />  <!-- Organism Group (NEW) -->
                        <ColumnDefinition Width="120" />  <!-- Identification -->
                        <ColumnDefinition Width="*" />    <!-- Notes -->
                        <ColumnDefinition Width="50" />   <!-- Image Count -->
                        <ColumnDefinition Width="32" />   <!-- Folder Button -->
                        <ColumnDefinition Width="32" />   <!-- Delete Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: Observation ID -->
                    <TextBlock Grid.Column="0" Text="{Binding ObservationId}" FontWeight="Bold"
                               Foreground="#4682B4" VerticalAlignment="Center" FontSize="12" />
                    
                    <!-- Col 1: Date -->
                    <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='\{0:yyyy-MM-dd\}'}"
                               Foreground="#999999" VerticalAlignment="Center" FontSize="12" />
                    
                    <!-- Col 2: Name -->
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,5,0" />
                    
                    <!-- Col 3: Organism Group (Inserted here) -->
                    <TextBlock Grid.Column="3" Text="{Binding OrganismGroup}" Foreground="#CCCCCC"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,5,0" FontSize="12" />

                    <!-- Col 4: Identification -->
                    <TextBlock Grid.Column="4" Text="{Binding Identification}" Foreground="#4CAF50"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,5,0" FontSize="12" />
                    
                    <!-- Col 5: Notes -->
                    <TextBlock Grid.Column="5" Text="{Binding Notes}" Foreground="#AAAAAA"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0" FontSize="12" />
                    
                    <!-- Col 6: Image Count -->
                    <TextBlock Grid.Column="6" Text="{Binding ImagePaths.Count, StringFormat='📷 {0}'}"
                               Foreground="#888888" VerticalAlignment="Center" FontSize="12" />
                    
                    <!-- Col 7: Folder Button -->
                    <Button Grid.Column="7" Click="BtnOpenFolder_Click" Tag="{Binding Id}" Content="📁"
                            Padding="4,2" FontSize="11" Background="#3E3E42" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" ToolTip="Open Entry Folder"
                            Margin="0,0,4,0" />
                    
                    <!-- Col 8: Delete Button -->
                    <Button Grid.Column="8" Click="BtnDeleteEntry_Click" Tag="{Binding Id}"
                            Content="🗑️"
                            Padding="4,2" FontSize="11" Background="#D32F2F" Foreground="#FFFFFF"
                            BorderThickness="0" Cursor="Hand" ToolTip="Delete Record" />
                </Grid>
            </Border>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>